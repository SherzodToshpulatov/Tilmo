# Copy to .dev.vars for `npm run dev`. Never commit .dev.vars.

# Google Cloud API key restricted to the Cloud Translation API.
GOOGLE_TRANSLATE_API_KEY=replace-with-your-google-api-key

# Comma-separated SHA-256 hashes of the access tokens allowed to call the API.
# Generate a token and its hash with: npm run token:create
API_ACCESS_TOKEN_HASHES=replace-with-64-character-sha256-hex-hash
